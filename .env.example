# ========================================================
# QuizBuilder Environment Configuration Template (.env.example)
# Rename this file to .env and fill in your actual values.
# NEVER commit .env to GitHub or public version control.
# ========================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Database -> Connect -> Connect your application
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quizbuilder?retryWrites=true&w=majority

# Isolated Test Database URI (Required for running test_complete_final_audit.js)
# Must contain 'test' in the database name (e.g. quizbuilder_test) to protect production data
MONGO_URI_TEST=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quizbuilder_test?retryWrites=true&w=majority

# JWT Authentication
# Use a cryptographically secure random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_EXPIRES_IN=24h

# Administrator Credentials
# ID and strong password for administrative access to the Admin Portal
ADMIN_ID=admin
ADMIN_PASSWORD=your_strong_admin_password_here

# Allowed Production Origins for CORS (comma-separated if multiple)
# Set to your Vercel frontend domain when deploying separately
ALLOWED_ORIGINS=https://your-quiz-app.vercel.app
